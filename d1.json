{
  "brand": {
    "name": "Houses",
    "tagline": "Partner with Houses. Let's Grow Together.",
    "description": "The premier marketplace for quality furniture partners.",
    "identity": {
      "logo_mark": "H",
      "voice": "Professional, Trustworthy, Growth-Oriented, Premium"
    }
  },
  "design_tokens": {
    "colors": {
      "primary": {
        "value": "#242C5A",
        "name": "Houses Navy",
        "description": "Main brand color, used for primary actions, headers, and key accents."
      },
      "secondary": {
        "value": "#F8FAFC",
        "name": "Slate 50",
        "description": "Backgrounds and subtle surfaces."
      },
      "accent": {
        "value": "#F1F5F9",
        "name": "Slate 100",
        "description": "Hover states and secondary elements."
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#64748B",
        "light": "#FFFFFF"
      }
    },
    "typography": {
      "font_family": "Geist Sans, sans-serif",
      "headings": {
        "weight": "800",
        "tracking": "tight",
        "style": "Modern, Bold"
      },
      "body": {
        "weight": "400",
        "style": "Clean, Legible"
      }
    },
    "shapes": {
      "radius": {
        "base": "0.625rem",
        "button": "9999px (rounded-full)",
        "input": "0.625rem (rounded-lg)",
        "card": "1.125rem (rounded-2xl)",
        "badge": "9999px (rounded-full)"
      }
    },
    "effects": {
      "shadows": {
        "default": "shadow-sm",
        "hover": "shadow-md",
        "button_primary": "shadow-lg shadow-primary/25",
        "card_hover": "shadow-xl hover:scale-[1.02] transition-all"
      },
      "animations": {
        "fade_in": "animate-in fade-in slide-in-from-bottom-4",
        "pulse": "animate-pulse"
      }
    }
  },
  "component_rules": {
    "buttons": {
      "style": "rounded-full",
      "padding": "px-6 py-2 (default), px-8 h-14 (lg)",
      "variants": {
        "primary": "bg-primary text-white shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30",
        "outline": "border-slate-200 hover:bg-slate-50 text-slate-900 rounded-full",
        "ghost": "text-slate-600 hover:text-primary hover:bg-transparent"
      }
    },
    "inputs": {
      "style": "rounded-lg border-input/60 bg-transparent h-11",
      "focus": "ring-2 ring-primary/20 border-primary"
    },
    "cards": {
      "style": "bg-white rounded-2xl border border-slate-200/60 shadow-sm",
      "behavior": "Clean, minimal shadows unless interactive"
    },
    "modals": {
      "style": "rounded-2xl bg-white p-6 shadow-2xl backdrop-blur-sm overlay"
    }
  }
}
